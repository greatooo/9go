{
  "compilerOptions": {
    "baseUrl": ".",
    "module": "ESNext",
    "target": "es2018",
    "moduleResolution": "node",
    "allowJs": true,
    "noImplicitAny": true,
    "strictNullChecks": true,
    "isolatedModules": true,
    "lib": ["DOM", "ES5", "ES6", "ES7"]
  },
  "include": ["**/*.ts"],
  "exclude": ["node_modules", ".bak-*"]
}
